{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plan-travel-guide:trip-schema:1.0",
  "title": "Travel Plan Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "updated_at",
    "trip",
    "constraints",
    "places",
    "decisions",
    "days",
    "reservations",
    "candidates",
    "tasks",
    "budget",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string" },
    "trip": {
      "type": "object",
      "required": ["id", "title", "start_date", "end_date", "timezone", "language", "currency"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "planning_phase": { "enum": ["exploration", "detailed"] },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "date_flexibility": { "$ref": "#/$defs/dateFlexibility" },
        "timezone": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "additionalProperties": true
    },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/idObject" } },
    "places": { "type": "array", "items": { "$ref": "#/$defs/place" } },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "days": { "type": "array", "items": { "$ref": "#/$defs/day" } },
    "reservations": { "type": "array", "items": { "$ref": "#/$defs/reservation" } },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
    "budget": { "type": "array", "items": { "$ref": "#/$defs/budget" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "idObject": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "$ref": "#/$defs/id" } },
      "additionalProperties": true
    },
    "sourceIds": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "dateFlexibility": {
      "type": "object",
      "required": ["status", "days_before", "days_after"],
      "properties": {
        "status": { "enum": ["fixed", "tentative", "unknown"] },
        "days_before": { "type": "integer", "minimum": 0 },
        "days_after": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "stayWindow": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["fixed", "tentative", "unassigned"] },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "days_before": { "type": "integer", "minimum": 0 },
        "days_after": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "dateAdjustment": {
      "type": "object",
      "required": ["scope", "kind", "proposed_start_date", "proposed_end_date", "minimum_change_days", "impact_summary", "decision_prompt"],
      "properties": {
        "scope": { "enum": ["trip", "city_stay"] },
        "kind": { "enum": ["shift", "extend_start", "extend_end", "place_city_stay", "move_city_stay", "reorder_route"] },
        "proposed_start_date": { "type": "string", "format": "date" },
        "proposed_end_date": { "type": "string", "format": "date" },
        "minimum_change_days": { "type": "integer", "minimum": 0 },
        "affected_ids": { "$ref": "#/$defs/sourceIds" },
        "impact_summary": { "type": "string", "minLength": 1 },
        "decision_prompt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "place": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "stay_window": { "$ref": "#/$defs/stayWindow" },
        "formatted_address": { "type": "string" },
        "map_url": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "accepted", "rejected", "superseded"] },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["id", "type", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["visit", "meal", "transfer", "checkin", "checkout", "event", "rest", "free_time", "other"] },
        "title": { "type": "string", "minLength": 1 },
        "start_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "place_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["proposed", "confirmed", "booked", "completed", "cancelled"] },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      },
      "additionalProperties": true
    },
    "day": {
      "type": "object",
      "required": ["date", "items"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "base_place_id": { "$ref": "#/$defs/id" },
        "summary": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      },
      "additionalProperties": true
    },
    "reservation": {
      "type": "object",
      "required": ["id", "type", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["lodging", "transport", "ticket", "meal", "activity", "other"] },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "confirmed", "booked", "completed", "cancelled"] },
        "place_id": { "$ref": "#/$defs/id" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      },
      "additionalProperties": true
    },
    "candidate": {
      "type": "object",
      "required": ["id", "category", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["shortlisted", "recommended", "selected", "rejected"] },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "current_window_start_date": { "type": "string", "format": "date" },
        "current_window_end_date": { "type": "string", "format": "date" },
        "start_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "place_id": { "$ref": "#/$defs/id" },
        "date_fit": { "enum": ["within_city_window", "overlaps_city_window", "within_trip_unassigned", "nearby_before", "nearby_after", "seasonal_flexible", "within_trip", "overlaps_trip"] },
        "date_confidence": { "enum": ["confirmed", "expected", "unknown"] },
        "route_fit": { "enum": ["direct", "nearby", "detour", "conflict", "unknown"] },
        "booking_timing": { "enum": ["book_early", "monitor", "walk_in", "not_applicable"] },
        "date_adjustment": { "$ref": "#/$defs/dateAdjustment" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["todo", "doing", "waiting", "blocked", "done", "dropped"] },
        "due_date": { "type": "string", "format": "date" },
        "related_ids": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "budget": {
      "type": "object",
      "required": ["id", "category", "title", "status", "currency", "amount"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["estimated", "quoted", "paid", "refunded", "cancelled"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "amount": { "type": "number" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["id", "type", "title", "freshness"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["user_statement", "official_site", "map", "booking_platform", "email", "calendar", "document", "estimate", "other"] },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "checked_at": { "type": "string" },
        "freshness": { "enum": ["current", "needs_refresh", "unknown"] }
      },
      "additionalProperties": true
    }
  }
}
